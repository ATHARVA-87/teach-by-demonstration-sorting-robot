<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_scene</name>
  <version>0.1.0</version>
  <description>Shared scene model: item attributes, boxes, workspace, seeded scene generation and the exact AR-to-world mapping.</description>
  <maintainer email="thombare.atharva16@gmail.com">Atharva Thombare</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
