<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_sim</name>
  <version>0.1.0</version>
  <description>Simulated sorting cell (MuJoCo): Franka Panda, table, boxes, randomized items and an overhead camera, exposed through the same ROS interfaces as a ros2_control Panda (FollowJointTrajectory, ParallelGripperCommand, joint_states, clock).</description>
  <maintainer email="thombare.atharva16@gmail.com">Atharva Thombare</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>sorting_common</exec_depend>
  <exec_depend>sorting_scene</exec_depend>
  <exec_depend>sorting_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
